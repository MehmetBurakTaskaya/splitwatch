{
  "name": "splitwatch",
  "productName": "Splitwatch",
  "version": "1.1.0",
  "description": "Watch several YouTube sports live streams side by side.",
  "author": "Mehmet Burak Taşkaya",
  "license": "MIT",
  "homepage": "https://github.com/MehmetBurakTaskaya/splitwatch",
  "repository": {
    "type": "git",
    "url": "https://github.com/MehmetBurakTaskaya/splitwatch.git"
  },
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "stats": "node scripts/stats.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/exo-2": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/youtube": "0.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "i18next": "26.5.12",
    "i18next-icu": "2.7.0",
    "intl-messageformat": "12.1.5",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "zustand": "5.1.0"
  }
}
